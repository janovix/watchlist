# Watchlist UI Environment Variables
# Copy this file to .env.local and fill in the values for your environment

# API Services
NEXT_PUBLIC_WATCHLIST_API_BASE_URL=https://watchlist-svc.janovix.workers.dev

# Auth Services
NEXT_PUBLIC_AUTH_SERVICE_URL=https://auth-svc.janovix.workers.dev
NEXT_PUBLIC_AUTH_APP_URL=https://auth.janovix.workers.dev

# Website URLs
NEXT_PUBLIC_HOMEPAGE_URL=https://www.janovix.com
NEXT_PUBLIC_TERMS_URL=https://www.janovix.com/terms
NEXT_PUBLIC_PRIVACY_URL=https://www.janovix.com/privacy

# Monitoring
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_ENVIRONMENT=development
